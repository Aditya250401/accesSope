# Local .env is loaded automatically. Never commit credentials.
OPENAI_API_KEY=
TAVILY_API_KEY=
CHAT_MODEL=gpt-4o
# Optional override of CHAT_MODEL:
OPENAI_MODEL=

# Tracing sends selected evidence and tool results. Use authorized, redacted data.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=accessscope
ACCESSSCOPE_AGENT_LABEL=accessscope
ACCESSSCOPE_ENVIRONMENT=local

# Direct AWS collection uses the SDK credential/profile chain.
# The agent needs a snapshot, not source-database credentials.
